namespace ara {
namespace diag {

/**
 * @brief Represents the configuration of a generic diagnostic session.
 * 
 * This class implements the logic required to manage diagnostic sessions,
 * including session control, performance monitoring, and bulk data handling
 * according to the SOVD specification. It integrates with the Communication
 * Management (COM) layer for IPC and utilizes persistent storage for event
 * overflow tracking.
 */
class GenericConfigurationImpl : public GenericConfiguration {
public:
    /**
     * @brief Constructs a new instance of the Generic Configuration.
     * 
     * Initializes the internal components including Session Control,
     * Performance Counter, and Crypto Context. Sets up default parameters
     * such as maximum sample counts and timeout values.
     * 
     * @param comClient Pointer to the initialized IpcClient for communication.
     * @param sessionId Unique identifier for the diagnostic session.
     * @param cryptoContext Shared pointer to the cryptographic context for signing/hashing.
     */
    explicit GenericConfigurationImpl(
        const std::shared_ptr<com::IpcClient>& comClient,
        uint32_t sessionId,
        const std::shared_ptr<security::CryptoContext>& cryptoContext);

    ~GenericConfigurationImpl() override = default;

    // ========================================================================
    // GenericConfiguration Interface Implementation
    // ========================================================================

    /**
     * @brief Starts a diagnostic session.
     * 
     * Initiates the session based on the configured parameters.
     * Validates prerequisites before starting.
     * 
     * @return Error code indicating success or failure.
     */
    core::Error startSession() override;

    /**
     * @brief Stops the currently active diagnostic session.
     * 
     * Cleans up resources associated with the session.
     * 
     * @return Error code indicating success or failure.
     */
    core::Error stopSession() override;

    /**
     * @brief Reads a parameter value from the target.
     * 
     * Retrieves a scalar parameter using the specified handle.
     * 
     * @param handle Handle identifying the parameter.
     * @param[out] value Output variable to store the read value.
     * @return Error code indicating success or failure.
     */
    core::Error readParameter(const com::FieldHandle& handle, ParameterValue& value) override;

    /**
     * @brief Writes a parameter value to the target.
     * 
     * Updates a scalar parameter using the specified handle.
     * 
     * @param handle Handle identifying the parameter.
     * @param value Value to write.
     * @return Error code indicating success or failure.
     */
    core::Error writeParameter(const com::FieldHandle& handle, const ParameterValue& value) override;

    /**
     * @brief Reads a bulk dataset from the target.
     * 
     * Retrieves a collection of records (e.g., DTCs, Events) efficiently.
     * Handles encryption/signature verification if configured.
     * 
     * @param handle Handle identifying the bulk data stream.
     * @param[out] records Vector to store the retrieved records.
     * @return Error code indicating success or failure.
     */
    core::Error readBulkData(const com::FieldHandle& handle, std::vector<BulkRecord>& records) override;

    /**
     * @brief Writes a bulk dataset to the target.
     * 
     * Sends a collection of records to the target.
     * Performs necessary hashing and signature generation.
     * 
     * @param handle Handle identifying the bulk data stream.
     * @param records Vector containing the records to send.
     * @return Error code indicating success or failure.
     */
    core::Error writeBulkData(const com::FieldHandle& handle, const std::vector<BulkRecord>& records) override;

    /**
     * @brief Checks if the session is currently active.
     * 
     * @return true if active, false otherwise.
     */
    bool isActive() const override;

private:
    // Internal implementation details
    std::shared_ptr<SessionControl> m_sessionControl;
    std::shared_ptr<PerformanceCounter> m_performanceCounter;
    std::shared_ptr<DtcManager> m_dtcManager;
    
    // Helper method for common COM operations
    core::Error executeWithRetry(com::Operation op, int maxRetries = 3);
};

} // namespace diag
} // namespace ara

#endif // DIAGNOSTICS_HPP
/**
 * @file diagnostics.hpp
 * @brief Public interface declaration for the AUTOSAR Adaptive Diagnostics component.
 * 
 * This header implements the `ara::diag` namespace interfaces required for 
 * Service-Oriented Vehicle Diagnostics (SOVD) compliance within the AUTOSAR 
 * Adaptive Platform R25-11. It provides access to configuration management,
 * DTC information handling, and event memory monitoring capabilities.
 * 
 * @note Implements the GenericConfiguration interface for bulk data operations
 *       and adheres to persistent storage requirements for event memory overflow tracking.
 */

#ifndef DIAGNOSTICS_HPP
#define DIAGNOSTICS_HPP

#include "ara/core/types.hpp"
#include "ara/com/api.hpp"
#include "ara/diag/api.hpp" // Includes diag::api definitions (DTCInformation, etc.)

namespace ara {
namespace diag {

/**
 * @struct ConfigurationHandle
 * @brief Handle structure for managing diagnostic configuration sessions.
 * 
 * Used internally by the implementation to track session state for 
 * GenericConfiguration operations.
 */
struct ConfigurationHandle {
    uint32_t sessionId;
};

/**
 * @class GenericConfiguration
 * @brief Interface for reading and writing diagnostic configurations.
 * 
 * Supports both parameter-based and bulk-data transfers according to SOVD standards.
 * Ensures secure storage and retrieval via platform-specific persistence mechanisms.
 */
class GenericConfiguration {
public:
    /**
     * @brief Reads a configuration value by name.
     * @param name Name of the configuration key.
     * @return bool True if successful, false otherwise.
     */
    static bool ReadConfig(const std::string& name);

    /**
     * @brief Writes a configuration value by name.
     * @param name Name of the configuration key.
     * @param value Value to write.
     * @return bool True if successful, false otherwise.
     */
    static bool WriteConfig(const std::string& name, const void* value);

    /**
     * @brief Reads a configuration block as bulk data.
     * @param configName Name of the configuration group.
     * @param data Buffer to store the retrieved data.
     * @param dataSize Size of the destination buffer.
     * @return size_t Number of bytes actually written. Returns 0 on failure.
     */
    static size_t ReadConfigAsBlob(const std::string& configName, void* data, size_t dataSize);

    /**
     * @brief Writes a configuration block as bulk data.
     * @param configName Name of the configuration group.
     * @param data Source data buffer.
     * @param dataSize Size of the source data.
     * @return bool True if successful, false otherwise.
     */
    static bool WriteConfigAsBlob(const std::string& configName, const void* data, size_t dataSize);

private:
    // Internal implementation details hidden from public API
    static bool _internal_ReadConfig(const std::string& name);
    static bool _internal_WriteConfig(const std::string& name, const void* value);
    static size_t _internal_ReadConfigAsBlob(const std::string& configName, void* data, size_t dataSize);
    static bool _internal_WriteConfigAsBlob(const std::string& configName, const void* data, size_t dataSize);
};

/**
 * @class DTCInformation
 * @brief Provides access to Diagnostic Trouble Code (DTC) related information.
 * 
 * Handles queries regarding DTC status, severity, and associated event memory states.
 * Integrates with the Communication Management (CM) for sample delivery patterns.
 */
class DTCInformation {
public:
    /**
     * @brief Retrieves information about a specific DTC instance.
     * @param dtcId Identifier of the DTC.
     * @param info Output structure to populate with DTC details.
     * @return bool True if information was successfully retrieved.
     */
    static bool GetInfo(uint32_t dtcId, DtcInfo& info);

    /**
     * @brief Checks if a specific DTC is currently active.
     * @param dtcId Identifier of the DTC.
     * @return bool True if the DTC is active.
     */
    static bool IsActive(uint32_t dtcId);

    /**
     * @brief Gets the last reported timestamp for a DTC.
     * @param dtcId Identifier of the DTC.
     * @param timestamp Pointer to output variable for timestamp.
     * @return bool True if timestamp is available.
     */
    static bool GetLastReportTimestamp(uint32_t dtcId, TimeStamp& timestamp);

    /**
     * @brief Queries the event memory overflow status for a specific DTC.
     * 
     * According to SWS_DM_00923, returns true if the number of stored entries
     * exceeds DiagnosticMemoryDestination.maxNumberOfEventEntries.
     * 
     * @param dtcId Identifier of the DTC.
     * @return bool True if event memory overflow has occurred for this DTC.
     */
    static bool GetEventMemoryOverflow(uint32_t dtcId);

    /**
     * @brief Resets the event counter for a specific DTC.
     * @param dtcId Identifier of the DTC.
     * @return bool True if reset was successful.
     */
    static bool ResetEventCounter(uint32_t dtcId);
    
    /**
     * @brief Sets a custom callback for DTC state changes.
     * @param handler Function pointer to handle state changes.
     * @return bool True if registration was successful.
     */
    static bool SetStateChangeHandler(StateChangeHandler handler);

    /**
     * @brief Unsets the custom callback for DTC state changes.
     * @return bool True if unregistration was successful.
     */
    static bool UnsetStateChangeHandler();
};

} // namespace diag
} // namespace ara

#endif // DIAGNOSTICS_HPP#ifndef DIAGNOSTICS_HPP
#define DIAGNOSTICS_HPP

#include "ara/com/api.h"
#include "ara/core/errorcode.h"
#include "ara/diag/api.h"
#include <functional>
#include <string>
#include <cstdint>

namespace diag {

/**
 * @brief Represents the configuration for a specific DTC Information instance.
 * 
 * This structure aligns with the GenericConfiguration interface requirements
 * found in the SOVD specification, providing access to both parameter-based
 * and bulk-data based configuration methods. It also includes logic to handle
 * persistent storage of event memory overflow information as per SWS_DM_00922.
 */
struct Configuration {
    /**
     * @brief Maximum number of entries allowed in the event memory.
     */
    uint32_t maxNumberOfEventEntries = 0;

    /**
     * @brief Flag indicating whether event memory overflow has occurred.
     * 
     * According to SWS_DM_00923, this flag should be set to true if there
     * exists already < maxNumberOfEventEntries> in the event memory and
     * an attempt was made to store an additional entry.
     */
    bool eventMemoryOverflowDetected = false;

    /**
     * @brief Pointer to the persistent storage location for overflow info.
     * 
     * Upstream requirement: RS_Diag_04093 mandates storing overflow info
     * persistently for each configured event memory.
     */
    void* persistentStorageHandle = nullptr;
};

/**
 * @brief Class representing detailed Diagnostic Trouble Code (DTC) information.
 * 
 * This class implements the core diagnostic entity capable of managing
 * event memories and reporting overflow conditions.
 */
class DTCInformation {
public:
    /**
     * @brief Constructs a new DTCInformation instance.
     * @param config The configuration object containing memory limits.
     */
    explicit DTCInformation(const Configuration& config);

    /**
     * @brief Retrieves the maximum number of event entries supported.
     * @return uint32_t The configured maximum number of entries.
     */
    uint32_t GetMaxNumberOfEventEntries() const;

    /**
     * @brief Checks if the event memory is currently overflowing.
     * 
     * Returns true if there exists already < maxNumberOfEventEntries> in the
     * event memory and a new entry cannot be stored (SWS_DM_00923).
     * 
     * @return bool True if overflow detected, false otherwise.
     */
    bool GetEventMemoryOverflow() const;

    /**
     * @brief Simulates adding a new event entry to test overflow logic.
     * 
     * In a real implementation, this would interact with the DMA/BulkData
     * APIs to push data into the kernel buffer. Here we simulate the check
     * against maxNumberOfEventEntries.
     * 
     * @return bool True if the addition caused an overflow, false if successful.
     */
    bool AddEventEntry();

private:
    mutable std::mutex m_mutex; // For thread-safe access to event counts
    uint32_t m_maxNumberOfEventEntries;
    volatile uint32_t m_currentEventCount;
    
    // Internal helper to update persistent storage status
    void UpdatePersistentOverflowStatus(bool overflow);
};

} // namespace diag

#endif // DIAGNOSTICS_HPP