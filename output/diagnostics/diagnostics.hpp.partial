#define DIAGNOSTICS_HPP

#include "ara/core/Types.hpp"
#include "ara/com/api.hpp"
#include "ara/diag/DtcInformation.hpp"
#include "ara/diag/GenericConfiguration.hpp"
#include "ara/diag/PersistentStorage.hpp"

namespace ara {
namespace diag {

/**
 * @brief Represents the state of an event memory overflow.
 * 
 * Indicates whether the number of stored entries has exceeded the maximum
 * allowed capacity (DiagnosticMemoryDestination.maxNumberOfEventEntries).
 */
enum class OverflowStatus : bool {
    NoOverflow = false,
    OverflowDetected = true
};

/**
 * @brief Exception thrown when attempting to access diagnostic data while
 * an event memory overflow is active.
 */
class MemoryOverflowException : public core::Exception {
public:
    explicit MemoryOverflowException(const std::string& message);
};

/**
 * @brief Class representing detailed information about Diagnostic Trouble Codes (DTCs).
 * Includes status flags, occurrence counts, and persistent storage references.
 * 
 * This class implements the logic required to handle event memory overflows
 * as per SWS_DM_00922 and SWS_DM_00923 specifications.
 */
class DTCInformation {
public:
    /**
     * @brief Constructs a DTCInformation instance.
     * 
     * Initializes the object with default values and links to the necessary
     * communication and storage interfaces.
     * 
     * @param comApi Pointer to the Communication Management API.
     * @param storageManager Pointer to the Persistent Storage Manager.
     */
    explicit DTCInformation(
        const com::api::CommunicationManagement* comApi,
        const storage::PersistentStorageManager* storageManager
    );

    ~DTCInformation() = default;

    // ========================================================================
    // Configuration Accessors
    // ========================================================================

    /**
     * @brief Retrieves the maximum number of event entries allowed in the memory.
     * 
     * @return uint32_t The configured maximum number of entries.
     */
    uint32_t getMaxNumberOfEventEntries() const;

    /**
     * @brief Sets the maximum number of event entries allowed in the memory.
     * 
     * @param value The new maximum number of entries.
     */
    void setMaxNumberOfEventEntries(uint32_t value);

    // ========================================================================
    // Status Query Methods
    // ========================================================================

    /**
     * @brief Checks if an event memory overflow has occurred.
     * 
     * According to SWS_DM_00923, this returns true if the number of stored
     * entries exceeds maxNumberOfEventEntries. It indicates that older entries
     * have been displaced due to lack of space.
     * 
     * @return bool True if overflow is detected, false otherwise.
     */
    bool getEventMemoryOverflow() const;

    /**
     * @brief Gets the current count of stored event entries.
     * 
     * @return uint32_t Current number of entries in the buffer.
     */
    uint32_t getCurrentEntryCount() const;

    /**
     * @brief Resets the overflow flag after processing.
     * 
     * Used internally by the DisplacementStrategy once old entries are cleared.
     */
    void clearOverflowFlag();

    // ========================================================================
    // Event Storage Operations
    // ========================================================================

    /**
     * @brief Attempts to add a new event entry to the memory.
     * 
     * Pre-condition: Caller must subscribe via ara::com before calling this.
     * Post-condition: If successful, entry count increments. If full, overflow
     *                 flag is set and the new entry is discarded.
     * 
     * @param event The event data to store.
     * @return bool True if added successfully, False if memory is full.
     */
    bool tryAddEventEntry(const EventData& event);

    /**
     * @brief Removes the oldest event entry from the memory.
     * 
     * Called by the DisplacementStrategy when an overflow is detected.
     * 
     * @return bool True if removal was successful, False if memory was empty.
     */
    bool removeOldestEventEntry();

    // ========================================================================
    // Generic Configuration Interface Implementation
    // ========================================================================

    // Implementation of GenericConfiguration for Bulk Data operations
    using BulkDataType = EventData;

    /**
     * @brief Reads configuration data from persistent storage.
     * 
     * @param key Identifier for the configuration item.
     * @param[out] value Buffer to store the retrieved data.
     * @param maxSize Size of the output buffer.
     * @return core::Result<SizeT> Result indicating success/failure and bytes written.
     */
    core::Result<size_t> readConfigAsBulkData(
        const std::string& key,
        BulkDataType& value,
        size_t maxSize
    ) override;

    /**
     * @brief Writes configuration data to persistent storage.
     * 
     * @param key Identifier for the configuration item.
     * @param value Data to be stored.
     * @return core::Result<void> Result indicating success/failure.
     */
    core::Result<void> writeConfigAsBulkData(
        const std::string& key,
        const BulkDataType& value
    ) override;

private:
    // Internal helper to check buffer limits before writing
    bool validateBufferSize(size_t bufferSize) const;

    // Private members
    const com::api::CommunicationManagement* m_comApi;
    const storage::PersistentStorageManager* m_storageManager;
    
    mutable std::mutex m_mutex; // For thread-safe access to counters
    
    uint32_t m_maxNumberOfEventEntries;
    uint32_t m_currentEntryCount;
    bool m_overflowActive;
};

} // namespace diag
} // namespace ara

