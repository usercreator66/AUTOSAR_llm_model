namespace diag {

/**
 * @brief Represents the state of an event memory relative to its maximum capacity.
 * 
 * This enum indicates whether the event memory associated with a specific DTC
 * has reached its configured limit (`maxNumberOfEventEntries`).
 */
enum class EventMemoryStatus {
    Available = false, ///< Memory has space for new entries
    Overflow          ///< Memory is full; new entries cannot be stored
};

/**
 * @brief Wrapper around the GenericConfiguration interface to handle diagnostic sessions.
 * 
 * This class provides a unified interface for reading/writing configuration data
 * and managing bulk data transfers according to the SOVD specification.
 * It integrates with the Communication Management (COM) layer for asynchronous
 * sample retrieval and state change handling.
 */
class SessionManager : public diag::GenericConfiguration {
public:
    /**
     * @brief Constructs a session manager instance.
     * 
     * Initializes the internal state required for COM-based diagnostics.
     * 
     * @param comContext Pointer to the active COM context. Must not be null.
     */
    explicit SessionManager(ara::com::Context* comContext);

    /**
     * @brief Destroys the session manager.
     * 
     * Cleans up resources and deregisters any pending subscriptions.
     */
    ~SessionManager() override;

    // ============================================================================
    // GenericConfiguration Interface Implementation
    // ============================================================================

    /// @name Configuration Accessors
    /// @{
    
    /**
     * @brief Reads a scalar configuration value.
     * 
     * Retrieves a single parameter from persistent storage.
     * 
     * @param key The identifier of the configuration parameter.
     * @return bool True if successful, false otherwise.
     */
    bool ReadParameter(const std::string& key) const override;

    /**
     * @brief Writes a scalar configuration value.
     * 
     * Stores a single parameter into persistent storage.
     * 
     * @param key The identifier of the configuration parameter.
     * @param value The value to store.
     * @return bool True if successful, false otherwise.
     */
    bool WriteParameter(const std::string& key, const std::uint8_t value) override;

    /// @}

    /// @name Bulk Data Accessors
    /// @{

    /**
     * @brief Reads a block of binary data (Bulk Data).
     * 
     * Retrieves a blob of data from persistent storage.
     * 
     * @param key The identifier of the bulk data item.
     * @param outBuffer Buffer to receive the data.
     * @param bufferSize Size of the output buffer.
     * @return std::size_t Number of bytes written to the buffer. Returns 0 on failure.
     */
    std::size_t ReadBlob(const std::string& key, std::vector<std::uint8_t>& outBuffer) const override;

    /**
     * @brief Writes a block of binary data (Bulk Data).
     * 
     * Stores a blob of data into persistent storage.
     * 
     * @param key The identifier of the bulk data item.
     * @param data The data to write.
     * @return bool True if successful, false otherwise.
     */
    bool WriteBlob(const std::string& key, const std::vector<std::uint8_t>& data) override;

    /// @}

    // ============================================================================
    // COM Integration Helpers
    // ============================================================================

    /**
     * @brief Subscribes to a diagnostic event stream.
     * 
     * Registers interest in receiving samples for a specific event type.
     * Enforces the `maxSampleCount` constraint defined in the SOVD spec.
     * 
     * @tparam EventType Type of the diagnostic event to subscribe to.
     * @param maxSampleCount Maximum number of samples allowed in the local buffer.
     *                        Exceeding this will result in an ErrorCode.
     * @return bool True if subscription was accepted, false otherwise.
     */
    template<typename EventType>
    bool Subscribe(std::uint32_t maxSampleCount) {
        auto* comApi = static_cast<ara::com::Api*>(this->m_comContext);
        
        // Step 1: Commitment check
        // Verify we haven't exceeded our committed limit before attempting action
        if (!comApi->CommitSubscription<EventType>(maxSampleCount)) {
            return false;
        }

        // Step 2: Perform subscription
        return comApi->Subscribe<EventType>();
    }

    /**
     * @brief Unsubscribes from a diagnostic event stream.
     * 
     * Removes interest in receiving samples for a specific event type.
     * 
     * @tparam EventType Type of the diagnostic event to unsubscribe from.
     * @return bool True if unsubscription was successful, false otherwise.
     */
    template<typename EventType>
    bool Unsubscribe() {
        auto* comApi = static_cast<ara::com::Api*>(this->m_comContext);
        return comApi->Unsubscribe<EventType>();
    }

    /**
     * @brief Checks the current occupancy of an event memory.
     * 
     * Determines if the event memory is currently full based on the configured
     * `maxNumberOfEventEntries`.
     * 
     * @tparam EventType Type of the diagnostic event.
     * @return bool True if the memory is full (overflow condition met), false otherwise.
     */
    template<typename EventType>
    bool IsEventMemoryFull() const {
        auto* comApi = static_cast<ara::com::Api*>(this->m_comContext);
        return comApi->IsEventMemoryFull<EventType>();
    }

    /**
     * @brief Fetches new diagnostic samples asynchronously.
     * 
     * Blocks until new samples arrive or the callback returns false.
     * Handles deserialization and passes pointers to the user callback.
     * 
     * @tparam EventType Type of the diagnostic event.
     * @param callback Function pointer to invoke for each new sample.
     *                 Signature: void(SamplePtr<const EventType>)
     * @param maxSamples Max number of samples to retrieve per call.
     * @return bool True if samples were processed, false if none available or error.
     */
    template<typename EventType, typename Callback>
    bool GetNewSamples(Callback callback, std::size_t maxSamples) {
        auto* comApi = static_cast<ara::com::Api*>(this->m_comContext);
        return comApi->GetNewSamples<EventType>(callback, maxSamples);
    }

    /**
     * @brief Sets a handler for subscription state changes.
     * 
     * Aggregates rapid state changes to prevent excessive interrupt overhead.
     * 
     * @tparam EventType Type of the diagnostic event.
     * @param handler Callback signature: void(bool newState)
     */
    template<typename EventType, typename Handler>
    void SetSubscriptionStateChangeHandler(Handler handler) {
        auto* comApi = static_cast<ara::com::Api*>(this->m_comContext);
        comApi->SetSubscriptionStateChangeHandler<EventType>(handler);
    }

private:
    // Internal implementation details handled by COM Context
    ara::com::Context* m_comContext;
};

} // namespace diag

