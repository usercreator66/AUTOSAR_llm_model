#define DIAGNOSTICS_HPP

#include "ara/com/IpcApi.h"
#include "ara/core/ErrorCode.h"
#include "ara/diag/DtcInformation.h"
#include "ara/diag/GenericConfiguration.h"
#include "ara/diag/PersistentStorage.h"
#include "ara/diag/SvdTypes.h"
#include <functional>
#include <vector>
#include <string>

namespace ara {
namespace diag {

/**
 * @brief Represents the configuration structure for a specific diagnostic session.
 * 
 * This struct holds the metadata required to establish a connection and retrieve
 * diagnostic data according to the SOVD specification. It includes identifiers,
 * sample counts, and flags indicating the state of the diagnostic session.
 */
struct SessionConfig {
    std::string sessionId;
    uint32_t maxSampleCount = 0;
    bool isActive = false;
};

/**
 * @brief Exception thrown when a diagnostic operation fails due to resource constraints
 * such as event memory overflow or invalid subscriptions.
 */
class DiagnosticException : public std::runtime_error {
public:
    explicit DiagnosticException(const std::string& message) 
        : std::runtime_error(message) {}
};

/**
 * @brief Factory class for creating persistent storage instances.
 * 
 * Responsible for initializing the underlying file systems and mapping logical
 * event memories to physical storage locations.
 */
class StorageFactory {
public:
    /**
     * @brief Creates a persistent storage instance for a given session ID.
     * 
     * @param sessionId Unique identifier for the diagnostic session.
     * @return std::unique_ptr<PersistentStorage> Pointer to the created storage object.
     * @throws DiagnosticException If storage initialization fails.
     */
    static std::unique_ptr<PersistentStorage> CreateSession(
        const std::string& sessionId);

    /**
     * @brief Destroys the storage instance and releases resources.
     */
    static void DestroySession(std::unique_ptr<PersistentStorage>& storage);
};

/**
 * @brief Manages the lifecycle of diagnostic sessions including subscription,
 * data retrieval, and overflow handling.
 */
class SessionManager {
public:
    /**
     * @brief Initializes a new diagnostic session.
     * 
     * Sets up the necessary IPC channels and prepares the event memory structures.
     * 
     * @param config Configuration details for the session.
     * @return ErrorCode Status of the initialization.
     */
    static ErrorCode Initialize(const SessionConfig& config);

    /**
     * @brief Terminates a diagnostic session and cleans up resources.
     */
    static ErrorCode Shutdown();

    /**
     * @brief Checks if a session is currently active.
     */
    static bool IsActive() { return g_activeSessions > 0; }
    
private:
    static int g_activeSessions;
};

} // namespace diag
} // namespace ara

