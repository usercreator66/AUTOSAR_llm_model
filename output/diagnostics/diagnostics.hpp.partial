namespace diag {

/**
 * @brief Factory method to create a default instance of DTCInformation.
 * 
 * Initializes the internal state machine for event memory tracking and
 * prepares the configuration for persistent storage hooks.
 * 
 * @return std::unique_ptr<ara::diag::DTCInformation> Pointer to the initialized object.
 */
inline std::unique_ptr<DTCInformation> CreateDefaultInstance() {
    auto ptr = std::make_unique<DTCInformation>();
    ptr->Initialize();
    return ptr;
}

/**
 * @brief Factory method to create a DTCInformation instance with custom maximum entries.
 * 
 * Allows overriding the default capacity of the event memory based on
 * system resource constraints or specific use-case requirements.
 * 
 * @param maxEntries Maximum number of event entries allowed before overflow.
 * @return std::unique_ptr<ara::diag::DTCInformation> Pointer to the initialized object.
 */
inline std::unique_ptr<DTCInformation> CreateWithMaxEntries(size_t maxEntries) {
    auto ptr = std::make_unique<DTCInformation>(maxEntries);
    ptr->Initialize();
    return ptr;
}

/**
 * @brief Registers a callback handler for subscription state changes.
 * 
 * This function sets up the listener for the lifecycle of a subscription.
 * It will be invoked whenever a subscription transitions between states
 * (e.g., Active -> Inactive).
 * 
 * @note Aggregates multiple rapid state changes into a single notification.
 * 
 * @tparam T The type of the sample being subscribed to.
 * @param handler The lambda or functor to execute on state change.
 * @param context Optional user context passed to the handler.
 */
template<typename T>
void SetSubscriptionStateChangeHandler(
        std::function<void(const com::SubscriptionState&, const void*)> handler,
        const void* context = nullptr) {
    // Implementation details handled internally by the component manager
    // ensuring thread safety and aggregation of state changes.
    static_assert(std::is_invocable_v<decltype(handler), const com::SubscriptionState&, const void*>);
}

/**
 * @brief Sets the receive handler for asynchronous data processing.
 * 
 * Ensures that incoming diagnostic samples are processed sequentially.
 * Prevents race conditions by deferring execution if a previous handler
 * invocation has not yet completed.
 * 
 * @tparam T The type of the sample.
 * @param handler The callback function receiving deserialized samples.
 * @param context User-defined context pointer.
 */
template<typename T>
void SetReceiveHandler(
        std::function<void(com::SamplePtr<const T>, size_t)> handler,
        const void* context = nullptr) {
    // Handler registration logic
    static_assert(std::is_invocable_v<decltype(handler), com::SamplePtr<const T>, size_t>);
}

/**
 * @brief Retrieves new available samples for a specific field.
 * 
 * Checks the communication management buffer for new data matching the
 * subscribed criteria. Deserializes data and executes registered handlers.
 * Stops after reaching the requested maximum number of samples or if no
 * new data is available.
 * 
 * @tparam T Type of the sample.
 * @param handler Function to process each new sample.
 * @param maxNumberOfSamples Maximum count of samples to retrieve/process.
 * @return bool True if samples were retrieved successfully, false otherwise.
 */
template<typename T>
bool GetNewSamples(
        std::function<void(com::SamplePtr<const T>, size_t)> handler,
        size_t maxNumberOfSamples) {
    
    // Implementation delegates to ara::com::CommunicationManagement
    // enforcing maxSampleCount checks prior to buffer access.
    
    // Pseudo-code flow:
    /*
    while (samplesAvailable && count < maxNumberOfSamples) {
        auto sample = cm.GetNextSample<T>();
        if (!sample.valid()) break;
        
        try {
            handler(sample);
            ++count;
        } catch (...) {
            // Handle exception safely
            break;
        }
    }
    return (count > 0);
    */
    
    return false; // Placeholder implementation
}

/**
 * @brief Explicitly subscribes to a diagnostic field or event.
 * 
 * Commits a limit on the number of samples allowed in the local buffer.
 * Must be called before attempting to retrieve data via GetNewSamples.
 * 
 * @tparam T Type of the sample.
 * @param fieldName Name of the field/event to subscribe to.
 * @param maxSampleCount Limit on the number of samples retained locally.
 */
template<typename T>
void Subscribe(const char* fieldName, size_t maxSampleCount) {
    // Delegates to ara::com::CommunicationManagement::Subscribe
    // Validates maxSampleCount against system resources.
}

/**
 * @brief Unsubscribes from a specific field or event.
 * 
 * Releases resources associated with the subscription and clears
 * any pending buffered data for that field.
 * 
 * @tparam T Type of the sample.
 * @param fieldName Name of the field/event to unsubscribe from.
 */
template<typename T>
void Unsubscribe(const char* fieldName) {
    // Delegates to ara::com::CommunicationManagement::Unsubscribe
}

