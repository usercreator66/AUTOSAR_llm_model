namespace diag {

/**
 * @brief Represents the result of a diagnostic request/response interaction.
 */
struct RequestResponseResult {
    bool success = false;
    core::ErrorCode errorCode = core::ErrorCode::OK;
};

/**
 * @brief Handles session control logic including start, stop, and reset.
 */
class SessionController {
public:
    /**
     * @brief Starts a diagnostic session.
     * 
     * @return true if session started successfully, false otherwise.
     */
    [[nodiscard]] static bool StartSession();

    /**
     * @brief Stops the currently active diagnostic session.
     * 
     * @return true if session stopped successfully, false otherwise.
     */
    [[nodiscard]] static bool StopSession();

    /**
     * @brief Resets the diagnostic session state.
     * 
     * @return true if reset successful, false otherwise.
     */
    [[nodiscard]] static bool ResetSession();

    /**
     * @brief Checks if a session is currently active.
     * 
     * @return true if session is active, false otherwise.
     */
    [[nodiscard]] static bool IsSessionActive();
};

} // namespace diag

