#define DIAGNOSTICS_HPP

#include "ara/core/ErrorCodes.h"
#include "ara/com/IpcApi.h"
#include "ara/diag/DtcInfoTypes.h"
#include "ara/diag/GenericConfiguration.h"
#include "ara/diag/BulkData.h"
#include "ara/diag/SvdTypes.h"

namespace ara {
namespace diag {

/**
 * @brief Represents the configuration of a specific DTC Information instance.
 *
 * This struct holds the mapping between a logical identifier (logicalId) and
 * its corresponding physical address in persistent storage. It also includes
 * metadata such as the maximum number of entries allowed in the event memory
 * associated with this DTC.
 */
struct DtcInstanceConfig {
    uint8_t logicalId;      ///< Logical ID of the DTC (as per ISO 14229 / UDS).
    uint32_t physicalAddress; ///< Physical address offset in flash/memory for storing event records.
    uint16_t maxNumberOfEventEntries; ///< Maximum capacity of the event memory for this instance.
};

/**
 * @brief Wrapper for handling DTC Information instances including their event memory status.
 *
 * Provides access to DTC details and checks for event memory overflow conditions
 * based on the SOVD specification and AUTOSAR Adaptive Platform SWS requirements.
 */
class DtcInformation {
public:
    /**
     * @brief Constructs a DtcInformation object for a given logical ID.
     *
     * @param logicalId The unique identifier for the DTC.
     * @param config Pointer to the static configuration describing storage location and limits.
     */
    explicit DtcInformation(uint8_t logicalId, const DtcInstanceConfig& config);

    /**
     * @brief Retrieves detailed information about the specified DTC.
     *
     * Populates the passed-out parameter with DTC status, severity, and occurrence count.
     *
     * @param outRef Reference to an output structure to populate with DTC info.
     * @return Error code indicating success or failure of the read operation.
     */
    auto GetDtcInfo(DtcInfoStruct& outRef) -> core::ErrorCodes;

    /**
     * @brief Checks if the event memory for this DTC has overflowed.
     *
     * According to SWS_DM_00923, if the number of stored events exceeds
     * maxNumberOfEventEntries, this returns true. Otherwise, false.
     *
     * @return true if the event memory is full and new entries cannot be added; false otherwise.
     */
    bool GetEventMemoryOverflow() const;

private:
    /// Unique identifier for this DTC instance.
    const uint8_t m_logicalId;
    
    /// Configuration reference for storage and limits.
    const DtcInstanceConfig& m_config;

    /// Internal pointer/reference to the actual storage container (implementation detail).
    void* m_eventStoragePtr; 
};

} // namespace diag
} // namespace ara

#endif // DIAGNOSTICS_HPP// ============================================================================
// File: diagnostics.hpp
// Role: Public Interface Declaration for AUTOSAR Adaptive Diagnostics Component
// Standard: AUTOSAR Adaptive Platform R25-11
// Namespace: ara::diag
// Description: 
//   Declares the GenericConfiguration interface and associated types required
//   for implementing the Service-Oriented Vehicle Diagnostics (SOVD) stack.
//   Includes definitions for DTC Information, Event Memory Overflow handling,
//   and Bulk Data configuration capabilities as per SWS_DM specifications.
// ============================================================================

#ifndef DIAGNOSTICS_HPP
#define DIAGNOSTICS_HPP

#include "ara/core/Types.hpp"
#include "ara/com/IpcClient.hpp"
#include "ara/com/SamplePtr.hpp"
#include "ara/com/Field.hpp"
#include "ara/com/SubscriptionManager.hpp"
#include "ara/diag/DtcInfo.hpp" // Internal header reference for implementation details

namespace ara {
namespace diag {

/**
 * @brief Represents the maximum number of entries allowed in an event memory.
 * 
 * This type corresponds to the configuration parameter `maxNumberOfEventEntries`
 * found in the Diagnostic Memory Destination configuration. It is used to determine
 * capacity before attempting to write new events.
 */
using MaxNumberOfEventEntries = uint32_t;

/**
 * @brief Enumeration representing the state of an event memory relative to its capacity.
 * 
 * Indicates whether the event memory has room for new entries or if an overflow
 * condition (SWS_DM_00922) has been triggered due to exceeding the configured limit.
 */
enum class EventMemoryStatus {
    Available,      ///< Memory has space for new entries (< maxNumberOfEventEntries)
    Overflow        ///< Memory is full (>= maxNumberOfEventEntries); new entries will be lost
};

/**
 * @brief Configuration structure for a specific event memory destination.
 * 
 * Defines the operational parameters for storing diagnostic events, including
 * the maximum allowable entries and the callback for handling overflow scenarios.
 */
struct EventMemoryConfig {
    /** Maximum number of event entries permitted in this memory instance. */
    MaxNumberOfEventEntries maxNumberOfEventEntries;
    
    /**
     * Callback invoked when the event memory reaches its maximum capacity.
     * 
     * @param[in] config Pointer to the EventMemoryConfig instance triggering the overflow.
     * @return bool True if the overflow was handled successfully, false otherwise.
     */
    using OverflowHandler = std::function<bool(const EventMemoryConfig&)>;
    
    OverflowHandler overflowHandler;
};

/**
 * @brief Interface for managing Diagnostic Trouble Code (DTC) information.
 * 
 * Provides access to DTC records, their severity levels, and persistent storage
 * status, including detection of event memory overflows (SWS_DM_00922).
 */
class DTCInformation {
public:
    /**
     * @brief Constructs a DTCInformation instance linked to a specific event memory ID.
     * 
     * @param[in] eventId Unique identifier for the event memory associated with these DTCs.
     */
    explicit DTCInformation(uint32_t eventId);

    /**
     * @brief Retrieves the list of currently detected trouble codes.
     * 
     * @return const vector<DtcRecord>& Reference to the list of active DTCs.
     */
    const std::vector<DtcRecord>& GetDetectedCodes() const;

    /**
     * @brief Checks if the event memory associated with this DTC information is overflowing.
     * 
     * According to SWS_DM_00923, this returns true if the number of stored events
     * equals or exceeds `maxNumberOfEventEntries`.
     * 
     * @return bool True if an overflow condition exists, false otherwise.
     */
    bool GetEventMemoryOverflow() const;

    /**
     * @brief Sets the maximum number of entries allowed for the associated event memory.
     * 
     * Used to configure the threshold before overflow triggers.
     * 
     * @param[in] newSize New maximum capacity.
     */
    void SetMaxEventEntries(MaxNumberOfEventEntries newSize);

private:
    uint32_t m_eventId;
    std::vector<DtcRecord> m_detectedCodes;
    MaxNumberOfEventEntries m_maxCapacity;
    bool m_isOverflowActive;
};

/**
 * @brief Abstract base class for Diagnostic Services supporting Bulk Data operations.
 * 
 * Implements the GenericConfiguration interface required for reading/writing
 * configurations as bulk data, leveraging ara::com for transport and security.
 */
class GenericConfiguration {
public:
    /**
     * @brief Type alias for a generic bulk data reader callback.
     * 
     * Called by the Communication Management after deserializing samples from
     * the kernel buffer.
     */
    using BulkDataReaderCb = std::function<void(ara::com::SamplePtr<const void>)>;

    /**
     * @brief Type alias for a generic bulk data writer callback.
     * 
     * Called by the Communication Management after serializing samples to
     * the kernel buffer.
     */
    using BulkDataWriterCb = std::function<void(ara::com::SamplePtr<DerivedType>, size_t)>;

    /**
     * @brief Reads configuration data as bulk data.
     * 
     * @param[in] reader Callback to invoke with deserialized samples.
     * @param[in] maxSamples Maximum number of samples to retrieve.
     * @return bool Status indicating success or failure.
     */
    virtual bool ReadBulk(BulkDataReaderCb reader, size_t maxSamples) = 0;

    /**
     * @brief Writes configuration data as bulk data.
     * 
     * @param[in] writer Callback to invoke with serialized samples.
     * @param[in] maxSamples Maximum number of samples to send.
     * @return bool Status indicating success or failure.
     */
    virtual bool WriteBulk(BulkDataWriterCb writer, size_t maxSamples) = 0;

    /**
     * @brief Subscribes to notifications about bulk data availability.
     * 
     * Must be called before invoking ReadBulk or WriteBulk.
     * 
     * @param[in] maxSampleCount Limit on the number of samples the local buffer can hold.
     * @return bool Success status.
     */
    virtual bool Subscribe(size_t maxSampleCount) = 0;

    /**
     * @brief Unsubscribes from bulk data notifications.
     * 
     * @return bool Success status.
     */
    virtual bool Unsubscribe() = 0;

protected:
    /**
     * @brief Helper method to check subscription validity before data transfer.
     * 
     * Ensures current sample count does not exceed committed maxSampleCount.
     * Returns false if limit exceeded (preventing buffer overflow).
     * 
     * @return bool True if subscription is valid, false if limit exceeded.
     */
    bool IsSubscriptionValid(size_t currentSampleCount, size_t maxSampleCount) const;
};

} // namespace diag
} // namespace ara

