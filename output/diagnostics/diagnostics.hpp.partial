    return instance;
}

/**
 * @brief Helper function to check event memory overflow status.
 * 
 * Checks if the specified event memory has reached its maximum capacity
 * (< DiagnosticMemoryDestination.maxNumberOfEventEntries>). Returns true
 * if an overflow would occur or has occurred, false otherwise.
 * 
 * @param memId Identifier of the event memory to check.
 * @return bool True if the event memory is full or overflowed, false otherwise.
 */
inline bool IsEventMemoryFull(uint8_t memId) {
    auto& dtcMgr = GetDtcManager();
    auto& notifMgr = GetNotificationManager();
    
    // Retrieve configuration for the specific memory destination
    const auto& config = dtcMgr.GetConfig().GetMemoryDestination(memId);
    
    // Check current count against max allowed entries
    uint32_t currentCount = 0;
    if (config.IsValid()) {
        currentCount = notifMgr.GetEventMemoryCurrentCount(memId);
    }
    
    return currentCount >= config.MaxNumberOfEventEntries();
}

