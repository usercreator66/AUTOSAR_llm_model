#ifndef DIAGNOSTICS_HPP
#define DIAGNOSTICS_HPP

#include "ara/com/api.h"
#include "ara/diag/api.h"
#include "ara/core/errorcode.h"
#include "ara/core/types.h"
#include <functional>
#include <vector>
#include <cstdint>

namespace diag {

/**
 * @brief Represents the configuration structure for generic diagnostic services.
 * 
 * This class implements the GenericConfiguration interface required by the 
 * Service-Oriented Vehicle Diagnostics (SOVD) architecture. It provides access 
 * to both parameter-based and bulk-data based configuration reading/writing.
 */
class GenericConfiguration {
public:
    /**
     * @brief Reads a configuration value by name.
     * @param name The identifier of the configuration item.
     * @return bool True if successful, false otherwise.
     */
    virtual bool ReadByName(const std::string& name) = 0;

    /**
     * @brief Writes a configuration value by name.
     * @param name The identifier of the configuration item.
     * @param value The value to write.
     * @return bool True if successful, false otherwise.
     */
    virtual bool WriteByName(const std::string& name, const void* value) = 0;

    /**
     * @brief Reads a list of configuration values by names.
     * @param names List of identifiers for configuration items.
     * @param values Buffer to store the retrieved values.
     * @param numValues Number of elements in the names/values arrays.
     * @return bool True if all reads were successful, false otherwise.
     */
    virtual bool ReadByNames(const std::vector<std::string>& names, 
                              void* values, 
                              uint32_t numValues) = 0;

    /**
     * @brief Writes a list of configuration values by names.
     * @param names List of identifiers for configuration items.
     * @param values Buffer containing the values to write.
     * @param numValues Number of elements in the names/values arrays.
     * @return bool True if all writes were successful, false otherwise.
     */
    virtual bool WriteByNames(const std::vector<std::string>& names, 
                               const void* values, 
                               uint32_t numValues) = 0;

    /**
     * @brief Deletes a configuration item by name.
     * @param name The identifier of the configuration item to delete.
     * @return bool True if successful, false otherwise.
     */
    virtual bool DeleteByName(const std::string& name) = 0;
};

/**
 * @brief Handles diagnostic trouble codes (DTCs) and event memory overflow tracking.
 * 
 * This class extends the standard DTC Information capabilities to include 
 * persistent storage and reporting of event memory overflows as per SWS_DM_00922 
 * and SWS_DM_00923 specifications.
 */
class DTCInformation {
public:
    /**
     * @brief Indicates whether an event memory overflow has occurred.
     */
    enum class OverflowStatus {
        NoOverflow,      ///< Memory capacity available (< maxNumberOfEventEntries)
        OverflowDetected ///< Memory full (>= maxNumberOfEventEntries)
    };

    /**
     * @brief Retrieves the current status of event memory overflow for a specific instance.
     * 
     * According to SWS_DM_00923, if the number of stored entries reaches 
     * maxNumberOfEventEntries, this method returns OverflowDetected.
     * 
     * @param instanceIndex Index of the event memory instance being queried.
     * @return OverflowStatus Current overflow status.
     */
    static OverflowStatus GetEventMemoryOverflow(uint32_t instanceIndex);

    /**
     * @brief Gets detailed information about a specific DTC.
     * @param dtcId The unique identifier of the DTC.
     * @param info Pointer to struct to populate with DTC details.
     * @return bool True if information was successfully retrieved.
     */
    static bool GetDtcInfo(uint32_t dtcId, DtcInfoStruct* info);

    /**
     * @brief Checks if a specific DTC is currently present.
     * @param dtcId The unique identifier of the DTC.
     * @return bool True if the DTC is present.
     */
    static bool IsPresent(uint32_t dtcId);

private:
    // Internal helper to check memory bounds before storing
    static bool CanStoreEntry(uint32_t instanceIndex);
    
    // Placeholder for internal state management
    static constexpr uint32_t MAX_EVENT_ENTRIES = 100; // Example constant derived from spec logic
};

} // namespace diag

#endif // DIAGNOSTICS_HPP#ifndef DIAGNOSTICS_HPP
#define DIAGNOSTICS_HPP

#include "ara/core/types.hpp"
#include "ara/com/api.hpp"
#include "ara/diag/api.hpp"
#include "ara/diag/dtc_information.hpp"
#include "ara/diag/configuration_interface.hpp"
#include "ara/diag/bulk_data_interface.hpp"

namespace diag {

/**
 * @brief Exception thrown when diagnostic operations fail due to resource constraints
 * such as event memory overflow or configuration errors.
 */
class DiagnosticException : public core::Exception {
public:
    explicit DiagnosticException(const std::string& message);
};

/**
 * @brief Factory class responsible for creating and configuring DTC Information instances.
 * 
 * This class provides the necessary interfaces to initialize DTC monitoring based on
 * the SOVD specification, handling both persistent storage and runtime event memory
 * management. It enforces the constraint that event memory cannot exceed the maximum
 * number of entries defined in the configuration.
 */
class DtcInfoFactory {
public:
    /**
     * @brief Creates a new instance of DtcInformation with default settings.
     * @return Pointer to newly created DtcInformation object.
     */
    static DtcInformation* Create();

    /**
     * @brief Creates a new instance of DtcInformation with custom configuration.
     * @param config Pointer to the configuration structure.
     * @return Pointer to newly created DtcInformation object.
     */
    static DtcInformation* Create(Configuration* config);

    /**
     * @brief Destroys the DTC information instance, releasing associated resources.
     * @param instance Pointer to the DtcInformation object to destroy.
     */
    static void Destroy(DtcInformation*& instance);
};

} // namespace diag

