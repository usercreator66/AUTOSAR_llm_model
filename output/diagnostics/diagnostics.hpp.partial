namespace ara {
namespace diag {

/**
 * @brief Represents the configuration structure for a specific DTC instance.
 * 
 * This struct holds the necessary metadata to identify a DTC within the
 * GenericConfiguration interface, including its index, severity level,
 * and associated event memory identifiers.
 */
struct DtcConfigEntry {
    uint32_t id;                  ///< Unique identifier for the DTC
    uint8_t severityLevel;        ///< Severity classification (e.g., Warning, Error)
    uint32_t eventId;             ///< Identifier for the associated event memory
};

/**
 * @brief Wrapper for persistent storage access related to diagnostics.
 * 
 * Provides a typed interface to retrieve and manipulate diagnostic data
 * stored in non-volatile memory, ensuring atomicity and consistency.
 */
class DiagPersistentStorageWrapper {
public:
    explicit DiagPersistentStorageWrapper(const std::string& moduleName);

    /**
     * @brief Retrieves the last known overflow status for a specific event memory.
     * 
     * Checks the persistent storage for flags indicating that the event memory
     * has exceeded its capacity (< maxNumberOfEventEntries).
     * 
     * @param eventId The unique ID of the event memory to check.
     * @return bool True if overflow occurred, false otherwise.
     */
    bool GetOverflowStatus(uint32_t eventId) const;

    /**
     * @brief Stores the overflow flag for a specific event memory.
     * 
     * Called when an attempt to write exceeds the maximum allowed entries.
     * Ensures the overflow indicator is preserved across reboots.
     * 
     * @param eventId The unique ID of the event memory.
     * @param overflow Flag indicating whether the overflow occurred.
     */
    void StoreOverflowStatus(uint32_t eventId, bool overflow);

private:
    std::string m_moduleName;
};

} // namespace diag
} // namespace ara

#endif // DIAGNOSTICS_HPP#ifndef DIAGNOSTICS_HPP
#define DIAGNOSTICS_HPP

#include "ara/com/api.hpp"
#include "ara/core/error_code.hpp"
#include "ara/diagnostics/types.hpp"
#include "ara/diagnostics/configurations.hpp"
#include "ara/diagnostics/events.hpp"

namespace ara {
namespace diag {

/**
 * @brief Represents a configuration instance capable of holding parameterized settings.
 * 
 * This class implements the GenericConfiguration interface allowing for both
 * individual parameter access and bulk data transfers via the ara::com API.
 */
class Configuration : public ara::com::Component<Configuration> {
public:
    /**
     * @brief Constructs a generic configuration instance.
     * @param name Unique identifier for the configuration.
     * @param type Type definition of the configuration structure.
     */
    explicit Configuration(const std::string& name, const DataType& type);

    /**
     * @brief Reads a single parameter value from the configuration.
     * @param key Parameter key.
     * @return Value associated with the key.
     */
    template<typename T>
    T ReadParameter(const std::string& key) const;

    /**
     * @brief Writes a single parameter value to the configuration.
     * @param key Parameter key.
     * @param value Value to write.
     */
    template<typename T>
    void WriteParameter(const std::string& key, const T& value);

    /**
     * @brief Reads the entire configuration as a bulk data block.
     * @param callback Function pointer to receive the deserialized data.
     * @param maxSize Maximum allowed size for the buffer.
     * @return ErrorCode indicating success or failure.
     */
    static Error ReadAsBulkData(void (*callback)(const uint8_t*, size_t), size_t maxSize);

    /**
     * @brief Writes the entire configuration as a bulk data block.
     * @param data Pointer to the byte array containing the configuration.
     * @param size Size of the byte array.
     * @return ErrorCode indicating success or failure.
     */
    static Error WriteAsBulkData(const uint8_t* data, size_t size);
};

/**
 * @brief Provides detailed information about Diagnostic Trouble Codes (DTCs),
 * including their occurrence history and event memory status.
 */
class DTCInformation {
public:
    /**
     * @brief Retrieves metadata about a specific DTC.
     * @param dtcId Identifier of the DTC.
     * @param info Output reference for DTC details.
     * @return True if successful, false otherwise.
     */
    bool GetDtcInfo(uint32_t dtcId, DtcInfo& info) const;

    /**
     * @brief Checks if the event memory for a specific DTC has overflowed.
     * 
     * An overflow occurs if the number of stored entries exceeds 
     * DiagnosticMemoryDestination.maxNumberOfEventEntries.
     * 
     * @param dtcId Identifier of the DTC.
     * @return true if the event memory is full and cannot accept more entries.
     *         false if there is space available.
     */
    bool GetEventMemoryOverflow(uint32_t dtcId) const;

    /**
     * @brief Resets the event counter for a specific DTC.
     * @param dtcId Identifier of the DTC.
     * @return True if reset was successful.
     */
    bool ResetEventCounter(uint32_t dtcId);

private:
    // Internal implementation details hidden from public interface
    mutable com::Mutex m_mutex;
};

} // namespace diag
} // namespace ara

#endif // DIAGNOSTICS_HPP#ifndef DIAGNOSTICS_HPP
#define DIAGNOSTICS_HPP

#include "ara/core/ErrorCodes.hpp"
#include "ara/com/IpcClient.hpp"
#include "ara/diag/DtcInformation.hpp"
#include "ara/diag/GenericConfiguration.hpp"
#include "ara/diag/BulkData.hpp"
#include "ara/diag/SessionControl.hpp"
#include "ara/diag/PerformanceMetrics.hpp"
#include "ara/diag/PersistentStorage.hpp"

namespace diag {

/**
 * @brief Represents the configuration of a specific DTC instance.
 * 
 * This structure holds the static metadata required to interpret DTC records,
 * including severity levels, short descriptions, and associated event memory indices.
 */
struct DtcInstanceConfig {
    uint32_t id;
    uint8_t severityLevel;
    const char* shortDescription;
    uint32_t numberOfOccurrences;
    uint32_t timeSinceFirstOccurrenceMs;
};

/**
 * @brief Manages the lifecycle of a DTC session.
 * 
 * Handles start/stop sequences and synchronization with the external environment.
 */
class SessionManager {
public:
    /**
     * @brief Starts a diagnostic session.
     * @return true if successful, false otherwise.
     */
    bool StartSession() {
        // Implementation details depend on the specific implementation of ara::diag::SessionControl
        // Typically involves setting up connections and initializing counters.
        return true;
    }

    /**
     * @brief Stops a diagnostic session.
     * @return true if successful, false otherwise.
     */
    bool StopSession() {
        // Implementation details depend on the specific implementation of ara::diag::SessionControl
        return true;
    }

    /**
     * @brief Checks if the session is currently active.
     * @return true if active, false otherwise.
     */
    bool IsSessionActive() const {
        return m_sessionActive;
    }

private:
    bool m_sessionActive = false;
};

/**
 * @brief Interface for reading/writing generic configuration parameters.
 * 
 * Provides access to non-bulk configuration items such as thresholds, limits,
 * and mapping tables.
 */
class GenericParameterReaderWriter {
public:
    /**
     * @brief Reads a parameter value.
     * @param key The identifier of the parameter.
     * @param value Pointer to the variable where the value will be stored.
     * @return Error code indicating success or failure.
     */
    core::Error ReadParameter(const std::string& key, void* value);

    /**
     * @brief Writes a parameter value.
     * @param key The identifier of the parameter.
     * @param value Pointer to the variable containing the value to write.
     * @return Error code indicating success or failure.
     */
    core::Error WriteParameter(const std::string& key, const void* value);
};

/**
 * @brief Interface for handling bulk data transfers.
 * 
 * Manages the transfer of large datasets (e.g., event logs, history buffers)
 * using persistent storage mechanisms and cryptographic signatures.
 */
class BulkDataReaderWriter {
public:
    /**
     * @brief Opens a handle for bulk data access.
     * @param name Name of the bulk data object.
     * @return Handle index or -1 on failure.
     */
    int OpenHandle(const std::string& name);

    /**
     * @brief Reads data from the bulk storage.
     * @param handle The open handle index.
     * @param buffer Buffer to receive data.
     * @param bufferSize Size of the buffer.
     * @param bytesRead Number of bytes actually read.
     * @return Error code indicating success or failure.
     */
    core::Error Read(int handle, void* buffer, size_t bufferSize, size_t& bytesRead);

    /**
     * @brief Writes data to the bulk storage.
     * @param handle The open handle index.
     * @param buffer Buffer containing data to write.
     * @param bytesToWrite Number of bytes to write.
     * @param bytesWritten Number of bytes actually written.
     * @return Error code indicating success or failure.
     */
    core::Error Write(int handle, const void* buffer, size_t bytesToWrite, size_t& bytesWritten);

    /**
     * @brief Deletes a bulk data handle.
     * @param handle The open handle index.
     * @return Error code indicating success or failure.
     */
    core::Error DeleteHandle(int handle);

    /**
     * @brief Signs data before writing to persistent storage.
     * @param handle The open handle index.
     * @param buffer Buffer containing data to sign.
     * @param signature Buffer to store the generated signature.
     * @param signatureSize Size of the signature buffer.
     * @return Error code indicating success or failure.
     */
    core::Error SignData(int handle, const void* buffer, void* signature, size_t signatureSize);

    /**
     * @brief Verifies the integrity of signed data.
     * @param handle The open handle index.
     * @param buffer Buffer containing signed data.
     * @param signature Signature to verify against.
     * @return true if valid, false otherwise.
     */
    bool VerifySignature(int handle, const void* buffer, const void* signature);
};

} // namespace diag

#endif // DIAGNOSTICS_HPP#ifndef DIAGNOSTICS_HPP
#define DIAGNOSTICS_HPP

#include "ara/com/IpcClient.h"
#include "ara/core/ErrorCode.h"
#include "ara/core/Types.h"
#include "ara/diag/DtcManagerApi.h"
#include "ara/diag/GenericConfiguration.h"
#include "ara/diag/SdcmApi.h"
#include "ara/diag/UdsApi.h"
#include "ara/diag/DbcApi.h"

namespace diag {

/**
 * @brief Represents the result of a diagnostic session request.
 */
struct SessionResult {
    bool success = false;
    uint8_t sessionId = 0xFF; // Default: No Session
};

/**
 * @brief Exception thrown when a diagnostic service fails due to invalid input or unsupported services.
 */
class DiagException : public std::exception {
public:
    explicit DiagException(const std::string& msg) : message_(msg) {}
    const char* what() const noexcept override { return message_.c_str(); }
private:
    std::string message_;
};

/**
 * @brief Factory class for creating diagnostic sessions based on configuration.
 */
class SessionFactory {
public:
    /**
     * @brief Creates a diagnostic session instance.
     * 
     * @param config Pointer to the GenericConfiguration structure containing session parameters.
     * @return SessionHandle Handle to the created session.
     * @throws DiagException If configuration is invalid or resource allocation fails.
     */
    static SessionHandle CreateSession(GenericConfiguration* config);

    /**
     * @brief Destroys a diagnostic session instance.
     * 
     * @param handle Handle to the session to be destroyed.
     */
    static void DestroySession(SessionHandle handle);
    
    /**
     * @brief Checks if a session handle is valid.
     * 
     * @param handle Handle to check.
     * @return true if valid, false otherwise.
     */
    static bool IsValidHandle(SessionHandle handle);
};

/**
 * @brief Main manager class for handling Diagnostic Trouble Codes (DTCs).
 * 
 * This class wraps the low-level UDS and SOVD APIs to provide a unified interface
 * for reading/writing DTCs, managing event memories, and handling overflow scenarios.
 */
class DtcManager {
public:
    /**
     * @brief Initializes the DTC manager with necessary resources.
     */
    void Initialize();

    /**
     * @brief Shuts down the DTC manager and releases resources.
     */
    void Shutdown();

    /**
     * @brief Reads a list of DTCs from the vehicle.
     * 
     * @param dtcs Vector to populate with retrieved DTCs.
     * @return ErrorCode Status of the operation.
     */
    ErrorCode ReadDtcList(std::vector<DtcInfo>& dtcs);

    /**
     * @brief Clears all stored DTCs from the vehicle.
     * 
     * @return ErrorCode Status of the operation.
     */
    ErrorCode ClearAllDtcRecords();

    /**
     * @brief Clears a specific DTC record.
     * 
     * @param dtcId Identifier of the DTC to clear.
     * @return ErrorCode Status of the operation.
     */
    ErrorCode ClearDtcRecord(uint32_t dtcId);

    /**
     * @brief Retrieves detailed information about a specific DTC.
     * 
     * @param dtcId Identifier of the DTC.
     * @param info Output parameter for DTC details.
     * @return ErrorCode Status of the operation.
     */
    ErrorCode GetDtcInformation(uint32_t dtcId, DtcInfo& info);

    /**
     * @brief Checks if an event memory has experienced an overflow.
     * 
     * According to SWS_DM_00923, if the number of entries exceeds maxNumberOfEventEntries,
     * this method returns true. It persists the overflow flag even after clearing the memory.
     * 
     * @param eventId ID of the event memory to check.
     * @return true if overflow occurred, false otherwise.
     */
    bool IsEventMemoryOverflow(uint32_t eventId) const;

    /**
     * @brief Sets up a callback to notify when an event memory overflows.
     * 
     * @param eventId ID of the event memory.
     * @param callback Function pointer to invoke on overflow.
     */
    void SetEventMemoryOverflowHandler(uint32_t eventId, OverflowCallback callback);

    /**
     * @brief Registers a generic configuration handler for bulk data operations.
     * 
     * @param configId Configuration ID.
     * @param handler Callback function.
     */
    void RegisterConfigHandler(uint32_t configId, ConfigHandler handler);

private:
    // Internal helper to map SOVD IDs to UDS Service Identifiers
    static uint16_t MapSovdToUds(uint32_t sovdId);

    // Internal helper to validate session before operation
    bool ValidateSession(SessionHandle session) const;

    // Member variables representing the singleton-like state
    SessionHandle m_sessionHandle;
    mutable com::IpcClient m_ipcClient;
    
    // Storage for persistent overflow flags (simulated via map in real impl)
    mutable std::map<uint32_t, bool> m_overflowFlags;
};

} // namespace diag

#endif // DIAGNOSTICS_HPP#ifndef DIAGNOSTICS_HPP
#define DIAGNOSTICS_HPP

#include "ara/com/api.h"
#include "ara/core/errorcode.h"
#include "ara/diag/api.h"
#include "ara/diag/types.h"
#include <functional>
#include <string>
#include <vector>

namespace diag {

/**
 * @brief Represents the configuration of a specific diagnostic session.
 * 
 * This structure holds the necessary context for performing diagnostic operations
 * such as reading/writing configuration parameters and bulk data transfers.
 */
struct SessionConfig {
    std::string sessionId;
    uint32_t timeoutMs = 1000;
};

/**
 * @brief Factory for creating diagnostic sessions.
 */
class SessionFactory {
public:
    /**
     * @brief Creates a new diagnostic session instance.
     * 
     * @param config Configuration details for the session.
     * @return std::unique_ptr<Session> Pointer to the newly created session.
     */
    static std::unique_ptr<Session> Create(const SessionConfig& config);
    
    /**
     * @brief Destroys the session and releases associated resources.
     */
    static void Destroy(std::unique_ptr<Session>& session);
};

/**
 * @brief Main diagnostic session manager.
 * 
 * Handles the lifecycle of diagnostic connections, including initialization,
 * termination, and the execution of diagnostic services according to SOVD standards.
 */
class Session {
public:
    // ============================================================================
    // Generic Configuration Interface Implementation
    // ============================================================================
    
    /**
     * @brief Reads a configuration parameter from the target ECU.
     * 
     * @param key Identifier for the configuration parameter.
     * @param value Buffer to store the retrieved value.
     * @param length Size of the destination buffer.
     * @return ErrorCode Status of the operation.
     */
    ErrorCode ReadConfig(const std::string& key, std::vector<uint8_t>& value) const;

    /**
     * @brief Writes a configuration parameter to the target ECU.
     * 
     * @param key Identifier for the configuration parameter.
     * @param value Data to be written.
     * @return ErrorCode Status of the operation.
     */
    ErrorCode WriteConfig(const std::string& key, const std::vector<uint8_t>& value) const;

    /**
     * @brief Reads a bulk dataset from the target ECU.
     * 
     * @param key Identifier for the bulk data service.
     * @param value Buffer to store the retrieved bulk data.
     * @param length Size of the destination buffer.
     * @return ErrorCode Status of the operation.
     */
    ErrorCode ReadBulkData(const std::string& key, std::vector<uint8_t>& value) const;

    /**
     * @brief Writes a bulk dataset to the target ECU.
     * 
     * @param key Identifier for the bulk data service.
     * @param value Data to be transmitted.
     * @return ErrorCode Status of the operation.
     */
    ErrorCode WriteBulkData(const std::string& key, const std::vector<uint8_t>& value) const;

    /**
     * @brief Terminates the diagnostic session.
     * 
     * Cleans up resources and closes the connection to the ECU.
     */
    void Close();

private:
    std::string m_sessionId;
    com::ConnectionHandle m_connectionHandle;
    bool m_isOpen;
};

// ============================================================================
// DTC Information Module
// ============================================================================

/**
 * @brief Manages DTC information including event memory tracking.
 */
class DTCInformation {
public:
    /**
     * @brief Initializes the DTC information manager.
     * 
     * Sets up persistent storage references and initializes counters.
     */
    static void Initialize();

    /**
     * @brief Adds a new DTC entry to the active list.
     * 
     * @param dtcId The unique identifier for the DTC.
     * @param text Description of the fault.
     * @param severity Severity level of the fault.
     * @return ErrorCode Status of the addition.
     */
    ErrorCode AddDtc(uint32_t dtcId, const std::string& text, DiagSeverity severity);

    /**
     * @brief Removes a DTC entry from the active list.
     * 
     * @param dtcId The unique identifier for the DTC.
     * @return ErrorCode Status of the removal.
     */
    ErrorCode RemoveDtc(uint32_t dtcId);

    /**
     * @brief Retrieves information about a specific DTC.
     * 
     * @param dtcId The unique identifier for the DTC.
     * @return Optional pointer to DTC info if found, nullptr otherwise.
     */
    std::shared_ptr<DtcInfo> GetDtcInfo(uint32_t dtcId) const;

    /**
     * @brief Checks if a specific event memory has overflowed.
     * 
     * An overflow occurs if the number of stored entries exceeds 
     * DiagnosticMemoryDestination.maxNumberOfEventEntries.
     * 
     * @param eventId The ID of the event memory to check.
     * @return true if the memory is full and cannot accept more entries.
     * @return false if there is space available.
     */
    bool IsEventMemoryOverflow(uint32_t eventId) const;

    /**
     * @brief Returns the current count of entries in a specific event memory.
     * 
     * @param eventId The ID of the event memory.
     * @return Current number of stored entries.
     */
    uint32_t GetEventMemoryEntryCount(uint32_t eventId) const;

    /**
     * @brief Gets the maximum allowed capacity for an event memory.
     * 
     * @param eventId The ID of the event memory.
     * @return Maximum number of entries allowed.
     */
    uint32_t GetMaxEventMemoryCapacity(uint32_t eventId) const;

    /**
     * @brief Stores a new event entry.
     * 
     * If the memory is full, this will mark the overflow flag and reject the write.
     * 
     * @param eventId The ID of the event memory.
     * @param timestamp Timestamp of the event.
     * @param frameId Frame identifier.
     * @param subAddress Sub-address of the frame.
     * @param value Raw byte values of the event.
     * @return ErrorCode Status of the storage operation.
     */
    ErrorCode StoreEvent(
        uint32_t eventId,
        uint64_t timestamp,
        uint32_t frameId,
        uint8_t subAddress,
        const std::vector<uint8_t>& value
    );

    /**
     * @brief Clears all event memories.
     */
    void ClearAllEvents();

private:
    struct EventMemory {
        std::vector<EventEntry> entries;
        uint32_t maxCapacity;
        bool overflowDetected;
        
        bool TryAddEntry(const EventEntry& entry);
    };

    mutable com::Mutex m_mutex;
    std::map<uint32_t, EventMemory> m_eventMemories;
    std::set<uint32_t> m_activeDtcs;
};

} // namespace diag

