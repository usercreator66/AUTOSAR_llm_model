#include "ara#ifndef DIAGNOSTICS_HPP
#define DIAGNOSTICS_HPP

#include "ara/com/api.hpp"
#include "ara/core/error_code.hpp"
#include "ara/diag/api.hpp"
#include <functional>
#include <string>
#include <vector>

namespace diag {

/**
 * @brief Represents the configuration of a generic diagnostic service instance.
 * 
 * This class implements the GenericConfiguration interface required by the
 * Service-Oriented Vehicle Diagnostics (SOVD) specification. It provides access
 * to both parameter-based configurations and bulk data transfers.
 */
class GenericConfiguration : public ara::diag::IGenericConfiguration {
public:
    /**
     * @brief Constructs a GenericConfiguration instance.
     * 
     * Initializes the object with a unique identifier for the diagnostic session.
     * 
     * @param sessionId Unique identifier for the diagnostic session context.
     */
    explicit GenericConfiguration(const std::string& sessionId);

    // ============================================================================
    // ara::diag::IGenericConfiguration Interface Implementation
    // ============================================================================

    /**
     * @brief Reads a configuration value by name.
     * 
     * Retrieves a scalar configuration parameter associated with the given key.
     * 
     * @param key The name of the configuration parameter.
     * @return bool True if the value was successfully retrieved; false otherwise.
     */
    bool ReadConfigValue(const std::string& key) override;

    /**
     * @brief Writes a configuration value by name.
     * 
     * Stores a scalar configuration parameter associated with the given key.
     * 
     * @param key The name of the configuration parameter.
     * @param value The value to write.
     * @return bool True if the value was successfully written; false otherwise.
     */
    bool WriteConfigValue(const std::string& key, const std::string& value) override;

    /**
     * @brief Reads a bulk data block by name.
     * 
     * Retrieves a large dataset (bulk data) associated with the given key.
     * This method leverages persistent storage mechanisms to handle large payloads.
     * 
     * @param key The name of the bulk data block.
     * @param outData Buffer to store the retrieved data.
     * @param outSize Pointer to integer receiving the number of bytes read.
     * @return bool True if data was successfully read; false otherwise.
     */
    bool ReadBulkData(const std::string& key, std::vector<uint8_t>& outData, uint32_t* outSize) override;

    /**
     * @brief Writes a bulk data block by name.
     * 
     * Stores a large dataset (bulk data) associated with the given key.
     * Includes signature generation and hash verification for security compliance.
     * 
     * @param key The name of the bulk data block.
     * @param data The data to write.
     * @param dataSize The size of the data to write.
     * @return bool True if data was successfully written; false otherwise.
     */
    bool WriteBulkData(const std::string& key, const std::vector<uint8_t>& data, uint32_t dataSize) override;

    /**
     * @brief Deletes a configuration value by name.
     * 
     * Removes a scalar configuration parameter from persistent storage.
     * 
     * @param key The name of the configuration parameter to delete.
     * @return bool True if the value was successfully deleted; false otherwise.
     */
    bool DeleteConfigValue(const std::string& key) override;

    /**
     * @brief Deletes a bulk data block by name.
     * 
     * Removes a large dataset from persistent storage.
     * 
     * @param key The name of the bulk data block to delete.
     * @return bool True if the data was successfully deleted; false otherwise.
     */
    bool DeleteBulkData(const std::string& key) override;

private:
    std::string m_sessionId;
};

} // namespace diag

#endif // DIAGNOSTICS_HPP#ifndef DIAGNOSTICS_HPP
#define DIAGNOSTICS_HPP

#include "ara/com/api.hpp"
#include "ara/core/error_code.hpp"
#include "ara/diagnostics/api.hpp"

namespace diag {

/**
 * @brief Represents the configuration of a generic diagnostic service.
 * 
 * This class implements the GenericConfiguration interface required by the
 * Service-Oriented Vehicle Diagnostics (SOVD) specification. It provides
 * capabilities for reading/writing configuration parameters and handling
 * bulk data transfers with associated security measures (signatures, hashes).
 */
class GenericConfiguration : public ara::diag::IGenericConfiguration {
public:
    /**
     * @brief Reads a parameter value from the configuration.
     * 
     * @param key Pointer to the destination buffer for the parameter name.
     * @param length Size of the destination buffer.
     * @return bool True if the parameter was found and copied successfully, false otherwise.
     */
    bool ReadParameter(const char* key, const uint8_t* value, uint32_t& length) override;

    /**
     * @brief Writes a parameter value to the configuration.
     * 
     * @param key Pointer to the source buffer containing the parameter name.
     * @param value Pointer to the source buffer containing the parameter value.
     * @param length Length of the value buffer.
     * @return bool True if the write operation was successful, false otherwise.
     */
    bool WriteParameter(const char* key, const uint8_t* value, uint32_t length) override;

    /**
     * @brief Reads a bulk data block from persistent storage.
     * 
     * This method triggers the retrieval of a complete data object. Security checks
     * (hash verification) are performed internally before returning the data to the
     * caller.
     * 
     * @param id Identifier for the bulk data item.
     * @param buffer Destination buffer for the retrieved data.
     * @param length Maximum number of bytes available in the destination buffer.
     * @param actualLength Output parameter indicating the actual number of bytes written.
     * @return bool True if data was successfully retrieved, false otherwise.
     */
    bool ReadBulkData(uint32_t id, uint8_t* buffer, uint32_t length, uint32_t& actualLength) override;

    /**
     * @brief Writes a bulk data block to persistent storage.
     * 
     * This method stores a complete data object. Internally, it generates a signature
     * and hash to ensure data integrity and authenticity upon future reads.
     * 
     * @param id Identifier for the bulk data item.
     * @param buffer Source buffer containing the data to be stored.
     * @param length Number of bytes to write.
     * @return bool True if the write operation was successful, false otherwise.
     */
    bool WriteBulkData(uint32_t id, const uint8_t* buffer, uint32_t length) override;

    /**
     * @brief Deletes a bulk data item from persistent storage.
     * 
     * @param id Identifier for the bulk data item to delete.
     * @return bool True if the deletion was successful, false otherwise.
     */
    bool DeleteBulkData(uint32_t id) override;

private:
    // Internal implementation details would reside here based on the
    // specific backend implementation (e.g., NvM, File System) defined in
    // the project workspace.
};

