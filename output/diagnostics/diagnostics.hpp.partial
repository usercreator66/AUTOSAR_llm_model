/**
 * @brief Exception thrown when diagnostic configuration fails due to invalid parameters.
 */
class DiagConfigException : public core::Exception {
public:
    explicit DiagConfigException(const std::string& message);
};

/**
 * @brief Factory class for creating persistent storage instances.
 * 
 * Handles the creation of persistent storage backends based on the specified
 * storage type (File System, RAM, etc.) and validates configuration before
 * instantiation.
 */
class StorageFactory {
public:
    /**
     * @brief Creates a persistent storage instance for the given path.
     * 
     * Validates the existence of the directory structure and initializes the
     * necessary file descriptors.
     * 
     * @param path Path to the storage location.
     * @return std::unique_ptr<PersistentStorage> Pointer to the created storage object.
     * @throws DiagConfigException If validation fails.
     */
    static std::unique_ptr<PersistentStorage> Create(const std::string& path);

    /**
     * @brief Checks if the specified storage path is valid and accessible.
     * 
     * @param path Path to check.
     * @return bool True if valid, false otherwise.
     */
    static bool IsPathValid(const std::string& path);
};

/**
 * @brief Wrapper class for managing DTC Information and Event Memory Overflow detection.
 * 
 * This class provides a unified interface to access DTC records and monitor
 * the status of event memories, including detecting overflow conditions as per
 * SWS_DM_00922 and SWS_DM_00923 specifications.
 */
class DtcInfoManager {
public:
    /**
     * @brief Constructs a manager for a specific DTC ID.
     * 
     * @param id The Diagnostic Trouble Code identifier.
     */
    explicit DtcInfoManager(uint32_t id);

    /**
     * @brief Retrieves detailed information about the last reported event for a specific memory destination.
     * 
     * @param memDestId The identifier of the memory destination.
     * @return const EventRecord& Reference to the latest event record.
     */
    const EventRecord& GetLastEvent(uint8_t memDestId) const;

    /**
     * @brief Checks if the event memory has overflowed.
     * 
     * Returns true if the number of stored entries exceeds the maximum allowed capacity
     * (< DiagnosticMemoryDestination.maxNumberOfEventEntries>).
     * 
     * @param memDestId The identifier of the memory destination.
     * @return bool True if overflow occurred, false otherwise.
     */
    bool HasEventMemoryOverflow(uint8_t memDestId) const;

    /**
     * @brief Resets the event counter for a specific memory destination.
     * 
     * Must be called after handling an overflow to clear the flag.
     * 
     * @param memDestId The identifier of the memory destination.
     */
    void ResetOverflowFlag(uint8_t memDestId);

private:
    uint32_t m_id;
    mutable std::mutex m_mutex;
    std::vector<EventRecord> m_eventMemories; // Size determined by configuration
    std::vector<bool> m_overflowFlags;       // Tracks overflow state per memory
};

} // namespace diag
} // namespace ara

