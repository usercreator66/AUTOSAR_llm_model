#include "ara/com/api.h"
#include "ara/diag/api.h"
#include "ara/diag/types.h"
#include "ara/diag/configurations.h"

namespace diag {

/**
 * @brief Factory method to create a GenericConfiguration instance.
 * 
 * Initializes the configuration object with default settings derived from
 * the ARXML configuration database. Handles initialization of persistent
 * storage references required for bulk data operations.
 */
inline auto CreateConfig() -> std::unique_ptr<GenericConfiguration> {
    static_assert(
        com::IsInitialized(),
        "Communication subsystem must be initialized before creating diagnostic configurations."
    );

    // Retrieve configuration from the database based on component ID
    const auto& config = diag_db::get_configuration(diag_db::ComponentId::DIAGNOSTIC_MANAGER);
    
    auto ptr = std::make_unique<GenericConfiguration>();
    ptr->Initialize(config);
    ptr->RegisterPersistenceContext();
    
    return ptr;
}

/**
 * @brief Reads a parameter value from the configuration.
 * 
 * @param key The identifier of the parameter to read.
 * @return bool True if the parameter was found and read successfully; false otherwise.
 */
inline bool ReadParameter(const std::string& key) {
    return diag_db::read_parameter(key);
}

/**
 * @brief Writes a parameter value to the configuration.
 * 
 * @param key The identifier of the parameter to write.
 * @param value The value to assign to the parameter.
 * @return bool True if the write operation succeeded; false otherwise.
 */
inline bool WriteParameter(const std::string& key, const std::any& value) {
    return diag_db::write_parameter(key, value);
}

/**
 * @brief Reads a bulk dataset from persistent storage.
 * 
 * Performs integrity checks (hash/signature) before returning data to the caller.
 * Ensures thread safety regarding concurrent access to the bulk data buffer.
 * 
 * @param key The identifier of the bulk dataset.
 * @param callback Function pointer or lambda to receive the deserialized data.
 * @return core::ErrorCode Error code indicating success or failure reason.
 */
inline core::ErrorCode ReadBulkData(const std::string& key, const com::Callable& callback) {
    using namespace com;
    
    // Step 1: Verify persistence context availability
    if (!diag_manager::Instance().HasPersistentStorage()) {
        return core::ErrorCode::INVALID_STATE;
    }

    // Step 2: Fetch raw bytes from storage
    auto result = diag_storage::fetch_bulk_data(key);
    if (!result.has_value()) {
        return core::ErrorCode::DATA_NOT_FOUND;
    }

    // Step 3: Validate integrity (Hash/Signature check)
    if (!diag_crypto::verify_integrity(result.value())) {
        return core::ErrorCode::INTEGRITY_CHECK_FAILED;
    }

    // Step 4: Deserialize and invoke callback
    try {
        auto sample_ptr = diag_deserializer::deserialize<std::vector<uint8_t>>(std::move(result));
        callback(sample_ptr);
        return core::ErrorCode::SUCCESS;
    } catch (...) {
        return core::ErrorCode::DESERIALIZATION_ERROR;
    }
}

/**
 * @brief Writes a bulk dataset to persistent storage.
 * 
 * Encrypts the data before writing to disk to ensure confidentiality.
 * 
 * @param key The identifier for the bulk dataset location.
 * @param data Pointer to the raw byte array containing the data.
 * @param length Size of the data array in bytes.
 * @return core::ErrorCode Error code indicating success or failure reason.
 */
inline core::ErrorCode WriteBulkData(const std::string& key, const uint8_t* data, size_t length) {
    using namespace com;
    
    // Step 1: Acquire lock on storage mutex
    auto guard = diag_storage::AcquireLock();
    if (!guard) {
        return core::ErrorCode::RESOURCE_CONFLICT;
    }

    // Step 2: Encrypt data
    auto encrypted_buffer = diag_crypto::encrypt(data, length);
    if (!encrypted_buffer) {
        return core::ErrorCode::ENCRYPTION_FAILURE;
    }

    // Step 3: Persist to non-volatile memory
    auto status = diag_storage::store_bulk_data(key, std::move(*encrypted_buffer));
    
    return status ? core::ErrorCode::SUCCESS : core::ErrorCode::STORAGE_FAILURE;
}

/**
 * @brief Deletes a bulk dataset from persistent storage.
 * 
 * Securely erases the data (overwrites with random bits) before freeing space.
 * 
 * @param key The identifier of the bulk dataset to delete.
 * @return core::ErrorCode Error code indicating success or failure reason.
 */
inline core::ErrorCode DeleteBulkData(const std::string& key) {
    using namespace com;
    
    auto guard = diag_storage::AcquireLock();
    if (!guard) {
        return core::ErrorCode::RESOURCE_CONFLICT;
    }

    // Perform secure erase
    diag_storage::secure_erase(key);
    
    return core::ErrorCode::SUCCESS;
}

// ============================================================================
// Event Memory Overflow Handling
// ============================================================================

/**
 * @brief Checks if an event memory has reached its maximum capacity.
 * 
 * Returns true if the number of stored entries equals the configured limit
 * (< DiagnosticMemoryDestination.maxNumberOfEventEntries>).
 * 
 * @param mem_id Identifier of the event memory to check.
 * @return bool True if the memory is full; false otherwise.
 */
inline bool IsEventMemoryFull(const std::string& mem_id) {
    auto& dm_instance = diag_manager::Instance();
    auto& mem_config = dm_instance.GetEventMemory(mem_id);
    
    if (!mem_config) {
        return false;
    }

    size_t current_count = mem_config->GetCurrentEntryCount();
    size_t max_entries = mem_config->GetMaxNumberOfEntries();

    return current_count >= max_entries;
}

/**
 * @brief Attempts to add an entry to an event memory.
 * 
 * If the memory is full, sets the overflow flag and returns false.
 * Otherwise, adds the entry and returns true.
 * 
 * @param mem_id Identifier of the target event memory.
 * @param entry The diagnostic event entry to store.
 * @return bool True if entry added successfully; false if overflow occurred.
 */
inline bool AddEventEntry(const std::string& mem_id, const diag::EventEntry& entry) {
    auto& dm_instance = diag_manager::Instance();
    auto& mem_config = dm_instance.GetEventMemory(mem_id);
    
    if (!mem_config) {
        return false;
    }

    // Pre-check overflow condition per SWS_DM_00922
    if (IsEventMemoryFull(mem_id)) {
        // Mark overflow state persistently
        dm_instance.SetEventMemoryOverflowFlag(mem_id, true);
        return false;
    }

    // Attempt insertion
    auto result = mem_config->AddEntry(entry);
    
    if (!result) {
        // Handle potential runtime failures even if pre-check passed
        dm_instance.SetEventMemoryOverflowFlag(mem_id, true);
    }

    return result;
}

/**
 * @brief Retrieves the overflow status of a specific event memory.
 * 
 * Corresponds to SWS_DM_00923: Returns true if attempts have been made 
 * beyond the configured limit.
 * 
 * @param mem_id Identifier of the event memory.
 * @return bool True if overflow has occurred; false otherwise.
 */
inline bool GetEventMemoryOverflowStatus(const std::string& mem_id) {
    auto& dm_instance = diag_manager::Instance();
    return dm_instance.IsEventMemoryOverflowFlagSet(mem_id);
}

/**
 * @brief Clears the overflow flag for an event memory after recovery.
 * 
 * Should be called once sufficient entries have been processed to free up space.
 * 
 * @param mem_id Identifier of the event memory.
 */
inline void ClearEventMemoryOverflowFlag(const std::string& mem_id) {
    diag_manager::Instance().ClearEventMemoryOverflowFlag(mem_id);
}

} // namespace diag

